# The purpose of this code is to create a math quiz with multiple difficulties and and scorecard.
import tkinter as tk
from tkinter import messagebox
from datetime import datetime
from PIL import Image, ImageTk # type: ignore


# Quiz app.
class QuizApp:
    """ This helps managing screen navigation"""
    def __init__(self, win):

        self.win = win
        self.win.title("Flow Computing Quiz")
        self.win.geometry("900x800")
        self.win.configure(bg="#d8c8ff")

        # This stores information about the player whilst playing the game.
        self.user = ""
        self.score = 0
        self.lives = 3
        self.mode = ""

        # Banner image for all screens.
        self.banner_img = Image.open("math banner.jpg")
        self.banner_img = self.banner_img.resize((320, 130))
        self.banner = ImageTk.PhotoImage(self.banner_img)

        # Questions for the quiz.
        self.quiz = {
            "easy": [["e1.png", 40], ["e2.png", 25], ["e3.png", 50], ["e4.png", 82], ["e5.png", 137]],
            "medium": [["m1.png", 5], ["m2.png", 10], ["m3.png", 13], ["m4.png", 9.43], ["m5.png", 32.31]],
            "hard": [["h1.png", 16], ["h2.png", 3.14], ["h3.png", 125], ["h4.png", 8], ["h5.png", 64]
]

        }

        # screens setup thing
        self.login = LoginScreen(self)
        self.menu = MenuScreen(self)
        self.quiz_screen = QuizScreen(self)
        self.scoreboard = ScoreboardScreen(self)

        self.login_page()

# Back to login.
    def login_page(self):
        self.menu.hide()
        self.quiz_screen.hide()
        self.scoreboard.hide()
        self.login.show()

# Menu screen.
    def menu_page(self):
        self.login.hide()
        self.menu.show()
        self.quiz_screen.hide()
        self.scoreboard.hide()

# Scoreboard screen.
    def scoreboard_page(self):
        self.login.hide()
        self.menu.hide()
        self.quiz_screen.hide()
        self.scoreboard.start()
        self.scoreboard.show()

# Start game.
    def start(self, mode):

        self.mode = mode
#Resets the game so new quizes start with the same score and number.
        self.score = 0
        self.lives = 3

        self.login.hide()
        self.menu.hide()
        self.scoreboard.hide()

        self.quiz_screen.start(mode)
        self.quiz_screen.show()


# Login screen.
class LoginScreen:
    """Handles user registration"""
    def __init__(self, app):

        self.app = app
        self.frame = tk.Frame(app.win, bg="#d8c8ff")

        tk.Label(self.frame, image=app.banner, bg="#d8c8ff").pack(pady=10)

        tk.Label(self.frame, text="Flow Computing Quiz",
                 font=("Calisto MT", 28, "bold"),
                 bg="#d8c8ff").pack(pady=20)

        tk.Label(self.frame, text="Username", bg="#d8c8ff", font=("Calisto MT", 22)).pack()
        self.user = tk.Entry(self.frame, font=("Calisto MT", 22))
        self.user.pack(pady=8)

        tk.Label(self.frame, text="Password", bg="#d8c8ff", font=("Calisto MT", 22)).pack()
        self.password = tk.Entry(self.frame, font=("Calisto MT", 22), show="*")
        self.password.pack(pady=8)

        tk.Button(self.frame, text="Sign Up",
                  font=("Calisto MT", 16), width=18, height=2,
                  command=self.signup).pack(pady=8)

        tk.Button(self.frame, text="Login",
                  font=("Calisto MT", 16), width=18, height=2,
                  command=self.login).pack(pady=8)

        tk.Button(self.frame, text="Quit",
                  font=("Calisto MT", 16), width=18, height=2,
                  bg="red", fg="white",
                  command=app.win.destroy).pack(pady=10)

        self.status = tk.Label(self.frame, text=" ",
                               bg="#d8c8ff", font=("Calisto MT", 14))
        self.status.pack(pady=10)

    def signup(self):

        u = self.user.get()
        p = self.password.get()

        if u == "" or p == "":
            messagebox.showerror("Error", "fill both boxes")
            return
# Username length check.
        if len(u) < 3:
            messagebox.showerror("Error", "username too short")
            return

        if len(u) > 15:
            messagebox.showerror("Error", "username too long")
            return

        f = open("usernpass.txt", "a")
        f.write(u + "," + p + "\n")
        f.close()

        messagebox.showinfo("Success", "Account Made")

    def login(self):

        u = self.user.get()
        p = self.password.get()

        try:
            f = open("usernpass.txt", "r")

#Checks eached saved user and password until it finds a match.
            for line in f:
                parts = line.strip().split(",")

                if len(parts) == 2:
                    if parts[0] == u and parts[1] == p:

                        self.app.user = u
                        self.status.config(text="Logged in " + u)

                        self.app.menu_page()
                        return

            messagebox.showerror("Error", "wrong login")

        except:
            messagebox.showerror("Error", "no file")

    def show(self):
        self.frame.pack(fill="both", expand=True)

    def hide(self):
        self.frame.pack_forget()



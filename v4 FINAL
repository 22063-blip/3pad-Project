# QUIZ screen
class QuizScreen:
    """Manages the quiz game play, scoring, lives, and user responses."""
    def __init__(self, app):

        self.app = app
        self.q = 0
        self.questions = []

        self.frame = tk.Frame(app.win, bg="#d8c8ff")

       
        tk.Label(self.frame, image=app.banner, bg="#d8c8ff").pack(pady=10)

        self.title = tk.Label(self.frame, text="Quiz",
                              font=("Calisto MT", 22, "bold"),
                              bg="#d8c8ff")
        self.title.pack(pady=10)

       
        self.info = tk.Label(self.frame, text="", bg="#d8c8ff", font=("Calisto MT", 14))
        self.info.pack(pady=5)

        # Question text.
        self.question = tk.Label(self.frame, text="",
                                 font=("Calisto MT", 18),
                                 bg="#d8c8ff")
        self.question.pack(pady=10)

        # Image goes here.
        self.image = tk.Label(self.frame, bg="#d8c8ff")
        self.image.pack(pady=10)

        # Answer box.
        self.answer = tk.Entry(self.frame, font=("Calisto MT", 18), width=18)
        self.answer.pack(pady=10)

        # Submit button.
        tk.Button(self.frame, text="Submit",
                  font=("Calisto MT", 16), width=18, height=2,
                  command=self.check).pack(pady=8)

       
        self.result = tk.Label(self.frame, text="", bg="#d8c8ff", font=("Calisto MT", 14))
        self.result.pack(pady=5)

        # back button just in case
        tk.Button(self.frame, text="Back",
                  font=("Calisto MT", 14),
                  command=app.menu_page).pack(pady=10)

    def start(self, mode):

        # Load questions from chosen mode.
        self.questions = self.app.quiz[mode]
        self.q = 0

        self.load()

    def load(self):

        # Stop if no more questions.
        if self.q >= len(self.questions):
            self.end()
            return

        img, ans = self.questions[self.q]
        self.ans = ans

        # Updating score and lives.
        self.info.config(
            text="Q " + str(self.q + 1)
                 + "| | Your Score: " + str(self.app.score)
                 + "| | Lives Remaining: " + str(self.app.lives)
        )

        self.question.config(text="solve these questions to decimal")

        # Try to load the image question, it it cannot be found, show message instead.
        try:
            pic = tk.PhotoImage(file=img)
            self.image.config(image=pic)
            self.image.image = pic
        except:
            self.image.config(text="No image")

        # Clear old answer.
        self.answer.delete(0, tk.END)

    def check(self):

        # Check the users answer.
        try:
            g = float(self.answer.get())
        except:
            messagebox.showerror("Error", "Numbers Only")
            return

        # Increase the score for a correct answer, otherwise remove one of the three lives.
        if g == self.ans:
            self.app.score += 1
        else:
            self.app.lives -= 1

        # Update display.
        self.result.config(
            text="| | Your Score: " + str(self.app.score)
                 + "| | Lives Remaining: " + str(self.app.lives)
        )

        # Game over if no lives.
        if self.app.lives <= 0:
            self.end()
            return

        # Next question.
        self.q += 1
        self.load()

    def end(self):

        # Finish screen thing.
        messagebox.showinfo("Quiz Ended!", "Your Score is " + str(self.app.score))

        # Save users final score so their quiz history is kept after the program closes.
        f = open("scores.txt", "a")
        f.write(self.app.user + "," + self.app.mode + ","
                + str(self.app.score) + "," + str(datetime.now()) + "\n")
        f.close()

# This redirects user to the difficulty selection page.
        self.app.menu_page()

    def show(self):
        self.frame.pack(fill="both", expand=True)

    def hide(self):
        self.frame.pack_forget()


# Scoreboard screen, just reads scores.txt and lists it out.
class ScoreboardScreen:
    """This displays the scoreboard with all the scores aswell as previous scores"""
    def __init__(self, app):

        self.app = app
        self.frame = tk.Frame(app.win, bg="#d8c8ff")

        tk.Label(self.frame, image=app.banner, bg="#d8c8ff").pack(pady=10)

        tk.Label(self.frame, text="Scoreboard",
                 font=("Calisto MT", 26, "bold"),
                 bg="#d8c8ff").pack(pady=20)

        # This is where the list of scores gets shown, updates it every time I open the page.
        tk.Button(self.frame,
                  text="Back",
                  font=("Calisto MT", 14),
                  command=app.menu_page
                  ).pack(pady=(0,10))
        
        self.list = tk.Label(
            self.frame,
            text="",
            bg="#d8c8ff",
            font=("Calisto MT", 16),
            justify="left"
            
        )
        self.list.pack()

    def start(self):

        # Read the scores file and build up the text to show.
        try:
            f = open("scores.txt", "r")
            lines = f.readlines()
            f.close()
        except:
            self.list.config(text="No scores yet")
            return

        # Nothing saved yet
        if len(lines) == 0:
            self.list.config(text="No scores yet")
            return

        text = ""
# Loops through eached line in the file and adds it to the display text.
        for line in lines:
            parts = line.strip().split(",")

            if len(parts) == 4:
                text += parts[0] + " - " + parts[1] + " - score " + parts[2] + "\n"

        self.list.config(text=text)

    def show(self):
        self.frame.pack(fill="both", expand=True)

    def hide(self):
        self.frame.pack_forget()


# Run.
root = tk.Tk()
app = QuizApp(root)
root.mainloop()
